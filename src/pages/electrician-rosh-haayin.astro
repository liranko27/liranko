---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import profile from '../assets/liran-profile-chat.png';
import ContactButton from '../components/ContactButton.astro';
import Measurement from '../components/Measurement.astro';
import AccessibilityMenu from '../components/AccessibilityMenu.astro';
import { business } from '../data/business';
import '../styles/global.css';
const title = 'חשמלאי מוסמך בראש העין והסביבה | לירן קוזוקרו — LIRANKO';
const description = 'איתור ותיקון תקלות חשמל, שקעים ותאורה לבית ולעסק בראש העין והסביבה. שירות אישי מלירן קוזוקרו, חשמלאי מוסמך, רישיון 996726. חייגו 058-6567657.';
const canonical = new URL('/electrician-rosh-haayin', business.domain).href;
const services = [
  ['איתור ותיקון תקלות חשמל', 'בירור של תקלה, קפיצות חשמל או נקודה שאינה פועלת, ובדיקת התשתית במקום לפני קביעת אופן התיקון.'],
  ['שקעים, מפסקים ונקודות חשמל', 'החלפה והוספה של שקעים, מפסקים ונקודות חשמל בהתאם לצורך ולתשתית הקיימת.'],
  ['תיקון והתקנת תאורה', 'טיפול בתקלות תאורה והתקנת גופי תאורה ופסי לד בבית או בעסק.'],
  ['בדיקה וטיפול בלוחות חשמל', 'בדיקת הלוח, איתור מקור התקלה וטיפול בהתאם לממצאים, לתשתית ולהסמכה.'],
];
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/><meta property="og:locale" content="he_IL"/><meta property="og:url" content={canonical}/>
  <meta property="og:image" content="https://liranko.co.il/social-preview.png"/>
  <meta name="theme-color" content="#080C14"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
</head>
<body data-gtm={business.gtmId} class="service-landing">
<a class="skip" href="#main">דלגו לתוכן</a>
<header class="header"><div class="container nav">
  <a href="/" class="brand" aria-label="לירנקו — עמוד הבית"><Image src={logo} alt="LIRANKO – פתרונות חשמל" width={240} format="webp"/></a>
  <nav aria-label="ניווט ראשי"><a href="#services">שירותים</a><a href="#process">איך מתאמים</a><a href="/portfolio">עבודות</a></nav>
  <ContactButton kind="phone" location="header" compact/>
</div></header>
<main id="main" tabindex="-1">
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">LIRANKO · לירן קוזוקרו</p>
      <h1 id="hero-title">חשמלאי מוסמך<br/><span>בראש העין והסביבה</span></h1>
      <p class="hero-subtitle">איתור ותיקון תקלות חשמל, שקעים ותאורה לבית ולעסק.</p>
      <p class="license">שירות אישי מלירן קוזוקרו · רישיון <bdi dir="ltr">996726</bdi></p>
      <div class="actions"><ContactButton kind="phone" location="hero" label="חייגו ללירן"/><ContactButton kind="whatsapp" location="hero" label="שלחו תיאור ותמונה בוואטסאפ"/></div>
      <p class="lead">א׳–ה׳ <bdi dir="ltr">08:00–17:00</bdi> · מועד העבודה בתיאום</p>
    </div>
    <div class="hero-art"><Image src={profile} alt="לירן קוזוקרו — חשמלאי מוסמך, בעל העסק LIRANKO" widths={[360,540,800]} sizes="(max-width: 760px) 90vw, 40vw" format="webp" loading="eager" fetchpriority="high"/><div class="art-bottom"><span>שירות אישי וישיר</span><span>חשמלאי מוסמך</span></div></div>
  </section>
  <section id="services" class="section container" aria-labelledby="services-title">
    <div class="section-heading"><div><p class="eyebrow">בבית ובעסק</p><h2 id="services-title">במה אפשר לעזור?</h2></div><p>קריאות שירות בראש העין והסביבה, כחלק מהשירות באזור המרכז.</p></div>
    <div class="services">{services.map(([name, text]) => <article class="service"><h3>{name}</h3><p>{text}</p></article>)}</div>
    <p class="fine-print">סוג העבודה והיקפה נקבעים לפי הצורך, הבדיקה במקום והתשתית הקיימת.</p>
    <div class="actions"><ContactButton kind="phone" location="services"/><ContactButton kind="whatsapp" location="services"/></div>
  </section>
  <section id="process" class="about-section"><div class="container service-process">
    <p class="eyebrow">מהפנייה ועד לתיאום</p><h2>איך מתקדמים?</h2>
    <ol><li><strong>מתקשרים או שולחים תיאור</strong><p>ספרו בקצרה מה לא עובד והיכן נדרש השירות. אפשר לצרף תמונה של המקום כפי שהוא, בלי לפתוח לוח או לפרק רכיבי חשמל.</p></li>
    <li><strong>מבררים את פרטי התקלה</strong><p>נברר יחד את התסמינים ואת מיקום העבודה, כדי להבין את הצורך ואת התאמת השירות.</p></li>
    <li><strong>מתאמים בדיקה או עבודה</strong><p>מתאמים מועד ומבררים את היקף העבודה והצעת המחיר בהתאם לפרטים ולממצאים.</p></li></ol>
  </div></section>
  <section class="section container service-about" aria-labelledby="about-title"><h2 id="about-title">לירן קוזוקרו, נעים להכיר</h2><p class="lead">אני חשמלאי מוסמך ובעל העסק LIRANKO. אני נותן שירות אישי לבית ולעסק באזור המרכז, כולל ראש העין והסביבה — מהשיחה הראשונה ועד הביצוע.</p><p class="license">{business.qualification}</p><a class="text-link" href="/portfolio">לצפייה בעבודות שביצעתי</a> · <a class="text-link" href="/">לכל שירותי החשמל של LIRANKO</a></section>
  <section id="contact" class="contact-section"><div class="container"><h2>צריכים לבדוק תקלה?</h2><p class="lead">דברו איתי ונתאם את השלב הבא לפי הצורך.</p><div class="actions"><ContactButton kind="phone" location="contact" label="חייגו ללירן"/><ContactButton kind="whatsapp" location="contact" label="שלחו תיאור ותמונה בוואטסאפ"/></div><p class="contact-region">א׳–ה׳ <bdi dir="ltr">08:00–17:00</bdi> · מועד העבודה בתיאום</p></div></section>
</main>
<footer class="container footer"><a class="footer-brand" href="/" dir="ltr">LIR<span>ϟ</span>NKO</a><p>© {new Date().getFullYear()} לירנקו – פתרונות חשמל</p><a class="text-link" href="/accessibility-draft" rel="nofollow">הצהרת נגישות</a><button id="consent-settings" class="text-link" type="button">העדפות פרטיות</button></footer>
<div class="mobile-contact"><ContactButton kind="phone" location="mobile-sticky" compact/><ContactButton kind="whatsapp" location="mobile-sticky" compact/></div>
<Measurement/><AccessibilityMenu/>
</body></html>

<style>
  .service-landing .hero h1 { font-size:calc(clamp(36px,4vw,58px) * var(--text-scale,1)); }
  .service-landing .hero-art { max-width:460px; justify-self:center; }
  .service-landing .services { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .service-process { padding-block:56px; }
  .service-process ol { padding-inline-start:28px; max-width:850px; }
  .service-process li { padding:12px 8px; }
  .service-process strong { font-size:calc(22px * var(--text-scale,1)); color:var(--white); }
  .service-process p { margin-block:8px; }
  .service-about { max-width:900px; }
  @media(max-width:760px) {
    .service-landing .hero h1 { font-size:calc(clamp(32px,8vw,42px) * var(--text-scale,1)); }
    .service-landing .hero-copy > .eyebrow { display:none; }
    .service-landing .hero-art { margin-top:8px; }
    .service-landing .hero-art img { aspect-ratio:2.1; max-height:170px; }
    .service-landing .art-bottom { display:none; }
    .service-landing .hero-subtitle { font-size:calc(19px * var(--text-scale,1)); }
    .service-landing .services { grid-template-columns:1fr; }
  }
</style>
