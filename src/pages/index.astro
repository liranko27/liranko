---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import heroProfile from '../assets/liran-profile-chat.png';
import portrait from '../assets/liran.png';
import Icon from '../components/Icon.astro';
import ProjectLightbox from '../components/ProjectLightbox.astro';
import ContactButton from '../components/ContactButton.astro';
import ShellyLogo from '../components/ShellyLogo.astro';
import { business } from '../data/business';
import { services } from '../data/services';
import { featuredProjects } from '../data/projects';
import '../styles/global.css';
import AccessibilityMenu from '../components/AccessibilityMenu.astro';
const title = 'לירן קוזוקרו — חשמלאי מוסמך באזור המרכז | LIRANKO';
const description = 'לירן קוזוקרו — חשמלאי מוסמך, רישיון 996726 ומתקין Shelly מורשה. שירותי חשמל לבית ולעסק באזור המרכז: תקלות, לוחות חשמל, תאורה ובית חכם. התקשרו 058-6567657.';
const canonical = business.domain ? new URL('/', business.domain).href : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  name: business.name,
  description,
  areaServed: business.serviceArea,
  identifier: { '@type': 'PropertyValue', propertyID: 'רישיון חשמלאי', value: '996726' },
  ...(canonical ? { url: canonical } : {}),
  ...(business.phone ? { telephone: business.phone } : {}),
  ...(business.logo ? { logo: business.logo } : {}),
  ...(business.socialLinks.length ? { sameAs: business.socialLinks } : {}),
};
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/>
{canonical ? <link rel="canonical" href={canonical}/> : <meta name="robots" content="noindex, nofollow"/>}
<meta property="og:type" content="website"/><meta property="og:locale" content="he_IL"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:site_name" content="LIRANKO"/><meta property="og:image" content="https://liranko.co.il/social-preview.png"/>
{canonical && <meta property="og:url" content={canonical}/>}
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content="https://liranko.co.il/social-preview.png"/>
<meta name="theme-color" content="#080C14"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}/>
</head>
<body data-gtm={business.gtmId}>
<a class="skip" href="#main">דלגו לתוכן</a>
<header class="header"><div class="container nav"><a href="#" class="brand" aria-label="לירנקו — עמוד הבית"><Image src={logo} alt="LIRANKO – פתרונות חשמל" width={240} format="webp"/></a><nav aria-label="ניווט ראשי"><a href="#services">שירותים</a><a href="#about">אודות</a><a href="#work">עבודות</a><a href="#contact">צור קשר</a></nav><ContactButton kind="phone" location="header" compact/></div></header>
<main id="main" tabindex="-1">
<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">LIRANKO · לירן קוזוקרו</p>
    <h1 id="hero-title">לירן קוזוקרו —<br/><span>חשמלאי מוסמך</span></h1>
    <p class="hero-subtitle">שירותי חשמל לבית ולעסק באזור המרכז</p>
    <p class="license">רישיון חשמלאי מס׳ <bdi dir="ltr">996726</bdi></p>
    <p class="lead">תיקון תקלות חשמל, לוחות חשמל, תאורה ופתרונות לבית חכם. שירות אישי וישיר, מהשיחה ועד הביצוע.</p>
    <div class="actions"><ContactButton kind="phone" location="hero"/><ContactButton kind="whatsapp" location="hero"/></div>
    <p class="shelly-certification"><span>מתקין</span><span role="img" aria-label="Shelly"><ShellyLogo /></span><span>מורשה</span></p>
    <p class="hero-slogan">הבית שלכם. החשמל שלכם. האחריות שלי.</p>
  </div>
  <div class="hero-art"><Image src={heroProfile} alt="לירן קוזוקרו — חשמלאי מוסמך" widths={[480,768,1100]} sizes="(max-width: 760px) 90vw, 45vw" format="webp" loading="eager" fetchpriority="high"/><div class="art-bottom"><span>שירות אישי וישיר</span><span>חשמלאי מוסמך</span></div></div>
</section>
<section id="services" class="section container"><div class="section-heading"><div><p class="eyebrow">01 / השירותים שלי</p><h2>שירותי חשמל לבית ולעסק</h2></div><p>תיקונים, התקנות ושדרוגים — בהתאם לצורך ולתשתית הקיימת.</p></div><div class="services">{services.map((service, i) => <article class="service"><div class="card-top"><span class="icon-box"><Icon name={service.icon}/></span><span class="number" dir="ltr">0{i + 1}</span></div><h3>{service.title}</h3><p>{service.description}</p></article>)}</div><p class="fine-print">סוג העבודה והיקפה ייקבעו לאחר בירור הצורך ובהתאם להסמכה ולתשתית הקיימת.</p><div class="actions"><ContactButton kind="phone" location="services"/><ContactButton kind="whatsapp" location="services"/></div></section>
<section id="about" class="about-section"><div class="container about"><div class="portrait"><Image src={portrait} alt="לירן קוזוקרו, בעל העסק לירנקו" widths={[340,560,682]} sizes="(max-width: 760px) 90vw, 40vw" format="webp" loading="lazy"/><div class="portrait-caption"><strong>לירן קוזוקרו</strong><span>האדם שמאחורי LIRANKO</span></div></div><div class="about-copy"><p class="eyebrow">קצת עליי</p><h2>נעים להכיר, <span class="blue">אני לירן.</span></h2><p class="lead">אני לירן קוזוקרו, חשמלאי מוסמך ובעל העסק LIRANKO. אני נותן שירות לבתים ולעסקים באזור המרכז, מהשיחה הראשונה ועד הביצוע.</p><p>העבודה מתחילה בהקשבה ובהבנת הצורך שלכם, וממשיכה בהתאמת פתרון לתשתית הקיימת. אני גם מתקין Shelly מורשה ומשלב פתרונות לבית חכם.</p><p class="license">{business.qualification}</p><ContactButton kind="phone" location="about"/></div></div></section>
<section id="work" class="section container"><div class="section-heading"><div><p class="eyebrow">03 / מהשטח</p><h2>עבודות נבחרות</h2></div><p>תאורה, לוחות חשמל ונקודות חשמל — מתוך העבודות שלי.</p></div><div class="project-gallery">{featuredProjects.map(project => <button type="button" class="project-card" data-project-card data-title={project.title} data-image={project.image} data-alt={project.alt} aria-label={`פתיחת תמונה: ${project.title}`}><img src={project.thumbnail} srcset={project.srcset} sizes="(max-width: 760px) 92vw, (max-width: 1000px) 45vw, 380px" alt={project.alt} width={project.width} height={project.height} loading="lazy" decoding="async"/><span class="project-card-title">{project.title}</span></button>)}</div><div class="portfolio-actions"><a class="button primary" href="/portfolio">לכל העבודות</a></div></section>
<section class="area container"><span class="icon-box"><Icon name="pin"/></span><div><p class="eyebrow">קרוב לבית שלכם</p><h2>שירות באזור המרכז</h2><p>ספרו לי היכן אתם נמצאים ומה צריך לעשות — נבדוק יחד את התאמת השירות.</p></div><a class="text-link" href="#contact">בואו נדבר <Icon name="arrow"/></a></section>
<section id="contact" class="contact-section"><div class="container"><p class="eyebrow">04 / מתחילים בשיחה</p><h2>צריכים חשמלאי?<br/><span class="blue">בואו נדבר.</span></h2><p class="lead">תקלה, התקנה או שדרוג? ספרו לי מה אתם צריכים.<br/>אפשר לשלוח בוואטסאפ תיאור קצר ותמונה של המקום.</p><div class="actions"><ContactButton kind="phone" location="contact"/><ContactButton kind="whatsapp" location="contact"/></div>{!business.phone && <p class="setup-note">מספר הטלפון טרם הוגדר. יצירת הקשר תהיה זמינה לאחר עדכון הפרטים.</p>}<p class="contact-region">LIRANKO · לירן קוזוקרו · אזור המרכז</p></div></section>
</main>
<footer class="container footer"><a class="footer-brand" href="#" dir="ltr">LIR<span>ϟ</span>NKO</a><p>© {new Date().getFullYear()} לירנקו – פתרונות חשמל</p><a class="text-link" href="/accessibility-draft" rel="nofollow">הצהרת נגישות</a><button id="consent-settings" class="text-link" type="button">העדפות פרטיות</button></footer>
<div class="mobile-contact"><ContactButton kind="phone" location="mobile-sticky" compact/><ContactButton kind="whatsapp" location="mobile-sticky" compact/></div>
<div id="consent-banner" class="consent" role="region" aria-label="העדפות פרטיות" hidden><p>אנו משתמשים בעוגיות וניתוח כדי לשפר את חוויית הגלישה ולהבין את השימוש באתר. אפשר לאשר מדידה או לדחות אותה בכל עת.</p><div><button data-consent="granted">אישור מדידה</button><button data-consent="denied">דחייה</button></div></div>
<ProjectLightbox />
<script>import '../scripts/tracking';</script>
<AccessibilityMenu /></body></html>
