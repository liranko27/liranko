---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import heroProfile from '../assets/liran-profile-chat.png';
import portrait from '../assets/liran.png';
import Icon from '../components/Icon.astro';
import ContactButton from '../components/ContactButton.astro';
import { business } from '../data/business';
import { services } from '../data/services';
import { featuredProjects } from '../data/projects';
import '../styles/global.css';
const title = 'חשמלאי מוסמך בראש העין והמרכז | LIRANKO – לירן קוזוקרו';
const description = 'מחפשים חשמלאי מוסמך בראש העין והמרכז? לירן קוזוקרו מציע תיקוני חשמל, התקנת תאורה, לוחות חשמל, עמדות טעינה ופתרונות בית חכם. צרו קשר!';
const canonical = business.domain ? new URL('/', business.domain).href : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  name: business.name,
  description,
  areaServed: business.serviceArea,
  ...(canonical ? { url: canonical } : {}),
  ...(business.phone ? { telephone: business.phone } : {}),
  ...(business.logo ? { logo: business.logo } : {}),
  ...(business.socialLinks.length ? { sameAs: business.socialLinks } : {}),
};
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/>
{canonical ? <link rel="canonical" href={canonical}/> : <meta name="robots" content="noindex, nofollow"/>}
<meta property="og:type" content="website"/><meta property="og:locale" content="he_IL"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:site_name" content="LIRANKO"/><meta property="og:image" content="/logo.png"/>
{canonical && <meta property="og:url" content={canonical}/>}
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content="/logo.png"/>
<meta name="theme-color" content="#080C14"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}/>
</head>
<body data-gtm={business.gtmId}>
<a class="skip" href="#main">דלגו לתוכן</a>
<header class="header"><div class="container nav"><a href="#" class="brand" aria-label="לירנקו — עמוד הבית"><Image src={logo} alt="LIRANKO – פתרונות חשמל" width={240} format="webp"/></a><nav aria-label="ניווט ראשי"><a href="#services">שירותים</a><a href="#about">אודות</a><a href="#work">עבודות</a><a href="#contact">צור קשר</a></nav><ContactButton kind="phone" location="header" compact/></div></header>
<main id="main">
<section class="hero container" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow"><span class="dot"></span> פתרונות חשמל • המרכז והשרון</p><h1 id="hero-title">הבית שלכם.<br/>החשמל שלכם.<br/><span>האחריות שלי.</span></h1><p class="hero-subtitle">לירן קוזוקרו | חשמלאי מוסמך | מתקין Shelly מורשה</p><p class="lead">עבודות חשמל בראש העין, המרכז והשרון. תיקון תקלות, התקנת לוחות חשמל, תאורה, עמדות טעינה ופתרונות לבית חכם.</p><div class="actions"><ContactButton kind="whatsapp" location="hero"/><ContactButton kind="phone" location="hero"/></div>{!business.phone && <p class="setup-note">פרטי יצירת הקשר יתווספו בקרוב — הכפתורים אינם פעילים כרגע.</p>}<div class="hero-foot"><span><Icon name="shield"/> הקפדה על בטיחות</span><span><Icon name="chat"/> שירות אישי וישיר</span></div></div><div class="hero-art"><span class="art-label" dir="ltr">LIRANKO / ELECTRICAL SOLUTIONS</span><Image src={heroProfile} alt="לירן קוזוקרו — חשמלאי מוסמך ומתקין Shelly מורשה" widths={[480,768,1100]} sizes="(max-width: 760px) 90vw, 50vw" format="webp" loading="eager" fetchpriority="high"/><div class="art-bottom"><span>חשמל טוב. בית שעובד.</span><span class="blue" dir="ltr">EST. FOR YOUR HOME ↗</span></div></div></section>
<div class="values-band"><div class="container values"><span><Icon name="chat"/>שירות אישי וישיר</span><span><Icon name="shield"/>הקפדה על בטיחות</span><span><Icon name="check"/>עבודה מסודרת ונקייה</span><span><Icon name="home"/>פתרונות מותאמים לכם</span></div></div>
<section id="services" class="section container"><div class="section-heading"><div><p class="eyebrow">01 / השירותים שלי</p><h2>כל מה שהבית צריך.<br/><span class="muted">במקום אחד.</span></h2></div><p>מתקלה קטנה ועד שדרוג מתוכנן.<br/>מתחילים בהבנת הצורך ומוצאים פתרון מתאים.</p></div><div class="services">{services.map((service, i) => <article class="service"><div class="card-top"><span class="icon-box"><Icon name={service.icon}/></span><span class="number" dir="ltr">0{i + 1}</span></div><h3>{service.title}</h3><p>{service.description}</p><ContactButton kind="whatsapp" location="services" service={service.detail} compact/></article>)}</div><p class="fine-print">סוג העבודה והיקפה ייקבעו לאחר בירור הצורך ובהתאם להסמכה ולתשתית הקיימת.</p></section>
<section id="about" class="about-section"><div class="container about"><div class="portrait"><Image src={portrait} alt="לירן קוזוקרו, בעל העסק לירנקו" widths={[340,560,682]} sizes="(max-width: 760px) 90vw, 40vw" format="webp" loading="lazy"/><div class="portrait-caption"><strong>לירן קוזוקרו</strong><span>האדם שמאחורי LIRANKO</span></div></div><div class="about-copy"><p class="eyebrow">02 / קצת עליי</p><h2>נעים להכיר,<br/><span class="blue">אני לירן.</span></h2><p class="lead">אני לירן קוזוקרו, בעל העסק LIRANKO. אני מאמין שעבודת חשמל טובה מתחילה בהקשבה, ממשיכה במתן פתרון מקצועי ומסתיימת בעבודה מסודרת ובטיחותית.</p><p>אני חשמלאי מוסמך, מתקין Shelly מורשה, ומספק שירות אישי וישיר ללקוחות באזור המרכז והשרון. בכל עבודה אני מתאים את הפתרון לצרכים של הבית, העסק או הפרויקט שלכם.</p>{business.qualification && <p>{business.qualification}</p>}<div class="signature" dir="ltr">Liran <span> / LIRANKO</span></div><ContactButton kind="whatsapp" location="about"/></div></div></section>
<section id="work" class="section container"><div class="section-heading"><div><p class="eyebrow">03 / מהשטח</p><h2>עבודות שבוצעו על הצד הטוב.</h2></div><p>שילוב של ביצוע מקצועי, עיצוב נקי ובטיחות בכל פרויקט.</p></div><div class="project-gallery">{featuredProjects.map(project => <button type="button" class="project-card" data-project-card data-title={project.title} data-image={project.image} data-alt={project.alt} aria-label={`פתיחת תמונה: ${project.title}`}><img src={project.image} alt={project.alt} width={project.width} height={project.height} loading="lazy"/><span class="project-card-title">{project.title}</span></button>)}</div><div class="portfolio-actions"><a class="button primary" href="/portfolio">לכל העבודות</a></div></section>
<section class="area container"><span class="icon-box"><Icon name="pin"/></span><div><p class="eyebrow">קרוב לבית שלכם</p><h2>שירות באזור המרכז והשרון</h2><p>ספרו לי היכן אתם נמצאים ומה צריך לעשות — נבדוק יחד את התאמת השירות.</p></div><a class="text-link" href="#contact">בואו נדבר <Icon name="arrow"/></a></section>
<section id="contact" class="contact-section"><div class="container"><p class="eyebrow">04 / מתחילים בשיחה</p><h2>צריכים חשמלאי?<br/><span class="blue">בואו נדבר.</span></h2><p class="lead">תקלה, התקנה או שדרוג? ספרו לי מה אתם צריכים.<br/>אפשר לשלוח בוואטסאפ תיאור קצר ותמונה של המקום.</p><div class="actions"><ContactButton kind="whatsapp" location="contact"/><ContactButton kind="phone" location="contact"/></div>{!business.phone && <p class="setup-note">מספר הטלפון טרם הוגדר. יצירת הקשר תהיה זמינה לאחר עדכון הפרטים.</p>}<p class="contact-region">LIRANKO · לירן קוזוקרו · המרכז והשרון</p></div></section>
</main>
<footer class="container footer"><a class="footer-brand" href="#" dir="ltr">LIR<span>ϟ</span>NKO</a><p>© {new Date().getFullYear()} לירנקו – פתרונות חשמל</p><button id="consent-settings" class="text-link" type="button">העדפות פרטיות</button></footer>
<div class="mobile-contact"><ContactButton kind="whatsapp" location="mobile-sticky" compact/><ContactButton kind="phone" location="mobile-sticky" compact/></div>
<div id="consent-banner" class="consent" role="region" aria-label="העדפות פרטיות" hidden><p>באישורכם נשתמש בכלי מדידה ופרסום כדי להבין את השימוש באתר. אפשר לסרב ולהמשיך להשתמש באתר.</p><div><button data-consent="granted">אישור מדידה ופרסום</button><button data-consent="denied">ללא מדידה ופרסום</button></div></div>
<div class="lightbox" id="project-lightbox" hidden aria-modal="true" role="dialog" aria-label="גלריית תמונות">
  <button type="button" class="lightbox-close" aria-label="סגור">×</button>
  <button type="button" class="lightbox-nav prev" aria-label="תמונה קודמת">‹</button>
  <div class="lightbox-media">
    <img class="lightbox-image" src="" alt="" />
    <p class="lightbox-title"></p>
  </div>
  <button type="button" class="lightbox-nav next" aria-label="תמונה הבאה">›</button>
</div>
<script>
import '../scripts/tracking';

const lightbox = document.getElementById('project-lightbox');
const lightboxImage = lightbox?.querySelector('.lightbox-image') as HTMLImageElement | null;
const lightboxTitle = lightbox?.querySelector('.lightbox-title') as HTMLParagraphElement | null;
const cards = Array.from(document.querySelectorAll('[data-project-card]')) as HTMLElement[];
const closeButton = lightbox?.querySelector('.lightbox-close') as HTMLButtonElement | null;
const prevButton = lightbox?.querySelector('.prev') as HTMLButtonElement | null;
const nextButton = lightbox?.querySelector('.next') as HTMLButtonElement | null;

let activeIndex = 0;

function updateLightbox(index: number) {
  if (!lightbox || !lightboxImage || !lightboxTitle || cards.length === 0) return;

  activeIndex = (index + cards.length) % cards.length;
  const card = cards[activeIndex];
  const imageUrl = card.getAttribute('data-image');
  const title = card.getAttribute('data-title');
  const alt = card.getAttribute('data-alt');

  if (!imageUrl || !title) return;

  lightboxImage.src = imageUrl;
  lightboxImage.alt = alt || title;
  lightboxTitle.textContent = title;
}

function openLightbox(index: number) {
  if (!lightbox) return;
  updateLightbox(index);
  lightbox.hidden = false;
  document.body.style.overflow = 'hidden';
}

function closeLightbox() {
  if (!lightbox) return;
  lightbox.hidden = true;
  document.body.style.overflow = '';
}

cards.forEach((card, index) => {
  card.addEventListener('click', () => openLightbox(index));
});

closeButton?.addEventListener('click', closeLightbox);
prevButton?.addEventListener('click', () => updateLightbox(activeIndex - 1));
nextButton?.addEventListener('click', () => updateLightbox(activeIndex + 1));
lightbox?.addEventListener('click', (event) => {
  if (event.target === lightbox) closeLightbox();
});

document.addEventListener('keydown', (event) => {
  if (lightbox && !lightbox.hidden) {
    if (event.key === 'Escape') closeLightbox();
    if (event.key === 'ArrowRight') updateLightbox(activeIndex + 1);
    if (event.key === 'ArrowLeft') updateLightbox(activeIndex - 1);
  }
});
</script>
</body></html>
