---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import ContactButton from '../components/ContactButton.astro';
import ProjectLightbox from '../components/ProjectLightbox.astro';
import { business } from '../data/business';
import { projects } from '../data/projects';
import '../styles/global.css';
import AccessibilityMenu from '../components/AccessibilityMenu.astro';

const title = 'עבודות חשמל באזור המרכז | לירן קוזוקרו — LIRANKO';
const description = 'מבט על עבודות חשמל, תאורה, עמדות טעינה, לוחות חשמל ופתרונות בית חכם שביצע לירן קוזוקרו באזור המרכז.';
const canonical = business.domain ? new URL('/portfolio', business.domain).href : undefined;
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://liranko.co.il/social-preview.png" />
    <meta property="theme-color" content="#080C14" />

  </head>
  <body data-gtm={business.gtmId}><a class="skip" href="#main">דלגו לתוכן</a>
    <header class="header">
      <div class="container nav">
        <a href="/" class="brand" aria-label="לירנקו — עמוד הבית">
          <Image src={logo} alt="LIRANKO – פתרונות חשמל" width={240} format="webp" />
        </a>
        <nav aria-label="ניווט ראשי">
          <a href="/#services">שירותים</a>
          <a href="/#about">אודות</a>
          <a href="/portfolio">עבודות</a>
          <a href="/#contact">צור קשר</a>
        </nav>
        <ContactButton kind="phone" location="header-portfolio" compact />
      </div>
    </header>

    <main id="main" tabindex="-1">
      <section class="portfolio-page container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">/ עבודות</p>
            <h1>עבודות חשמל באזור המרכז</h1>
          </div>
          <a class="button secondary" href="/">חזרה לעמוד הבית</a>
        </div>

        <div class="project-gallery portfolio-gallery">
          {projects.map((project, index) => (
            <button type="button" class="project-card" data-project-card data-index={index} data-title={project.title} data-image={project.image} data-alt={project.alt} aria-label={`פתיחת תמונה: ${project.title}`}>
              <img src={project.thumbnail} srcset={project.srcset} sizes="(max-width: 760px) 92vw, (max-width: 1000px) 45vw, 380px" alt={project.alt} width={project.width} height={project.height} loading="lazy" />
              <span class="project-card-title">{project.title}</span>
            </button>
          ))}
        </div>
      </section>
    </main>

    <ProjectLightbox /><script>import '../scripts/tracking';</script>
    <footer class="container footer">
      <a class="footer-brand" href="/" dir="ltr">LIR<span>ϟ</span>NKO</a>
      <p>© {new Date().getFullYear()} לירנקו – פתרונות חשמל</p>
      <a class="text-link" href="/accessibility-draft" rel="nofollow">הצהרת נגישות</a><button id="consent-settings" class="text-link" type="button">העדפות פרטיות</button>
    </footer>
    <div class="mobile-contact"><ContactButton kind="phone" location="mobile-sticky" compact/><ContactButton kind="whatsapp" location="mobile-sticky" compact/></div>
    <div id="consent-banner" class="consent" role="region" aria-label="העדפות פרטיות" hidden>
      <p>אנו משתמשים בעוגיות וניתוח כדי לשפר את חוויית הגלישה ולהבין את השימוש באתר. אפשר לאשר מדידה או לדחות אותה בכל עת.</p>
      <div>
        <button data-consent="granted">אישור מדידה</button>
        <button data-consent="denied">דחייה</button>
      </div>
    </div>
  <AccessibilityMenu /></body>
</html>
